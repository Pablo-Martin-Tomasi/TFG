<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4 p-4 upload-card">

        <div class="text-center mb-4">
            <i class="bi bi-image-fill display-4 text-success"></i>
            <h3 class="mt-2">Añadir imágenes a la ruta</h3>
            <p class="text-muted">Comparte paisajes, senderos y momentos únicos</p>
        </div>

        <form action="/ruta/{{ruta.id_ruta}}/anadirImagenRuta" method="POST" enctype="multipart/form-data">

            <label class="upload-box text-center p-5 w-100">
                <i class="bi bi-cloud-arrow-up display-5 text-success"></i>
                <p class="mt-3 mb-1">Arrastra tus imágenes aquí</p>
                <small class="text-muted">o haz clic para seleccionarlas</small>
                <input type="file" name="imagenesRuta" multiple accept="image/*" hidden>
            </label>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success px-4 py-2 rounded-pill">
                    <i class="bi bi-upload me-2"></i> Subir imágenes
                </button>
            </div>
        </form>

        {{#if error}}
        <div class="alert alert-danger mt-4 text-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{error}}
        </div>
        {{/if}}

    </div>
</div>
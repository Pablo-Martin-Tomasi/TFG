<div class="text-center mt-4">
    <a href="/anadirRuta" class="btn-anadirRuta">Organizar ruta</a>
</div>
<br>
<div class="filter-container mx-auto" style="max-width: 900px;">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100 p-3 shadow-sm border-0 rounded-4">
                <label for="filtroDificultad" class="form-label fw-bold text-success">
                    <i class="bi bi-filter-circle me-2"></i>Filtrar rutas por dificultad
                </label>
                <select id="filtroDificultad" class="form-select rounded-pill" onchange="filtros()">
                    <option value="">Todas las dificultades</option>
                    <option value="Fácil">Fácil</option>
                    <option value="Normal">Normal</option>
                    <option value="Difícil">Difícil</option>
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 p-3 shadow-sm border-0 rounded-4">
                <label for="filtroTipoRuta" class="form-label fw-bold text-success">
                    <i class="bi bi-filter-circle me-2"></i>Filtrar por tipo de ruta
                </label>
                <select id="filtroTipoRuta" class="form-select rounded-pill" onchange="filtros()">
                    <option value="">Todos los tipos</option>
                    <option value="circular">Circular</option>
                    <option value="ida_vuelta">Ida y vuelta</option>
                </select>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card h-100 p-2 shadow-sm border-0 rounded-4">
                <label class="form-label fw-bold text-success mb-2" style="font-size: 0.85rem;">
                    <i class="bi bi-geo-alt-fill me-2"></i>Filtrar por dirección
                </label>
                <div class="d-flex flex-wrap gap-2 overflow-auto" style="max-height: 120px; padding: 8px; border: 1px solid #eee; border-radius: 10px;">
                    {{#each direcciones}}
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input filtro-direccion" type="checkbox" value="{{this}}" id="check-{{@index}}" onchange="filtros()">
                        <label class="form-check-label" for="check-{{@index}}" style="font-size: 0.78rem;">
                            {{this}}
                        </label>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>
<br>
<div class="contenedor">
    {{#each routes}}
    <div class="card custom-card" data-dificultad="{{dificultad_ruta}}" data-tipo="{{tipo_ruta}}" data-direccion="{{direccion}}">
        <div class="card-img-container">
            <div id="map-{{id_ruta}}" class="map-card"></div>
        </div>

        <div class="card-body">
            <div class="card-main-info">
                <h5 class="card-title">{{nombre_ruta}}</h5>
                <span class="badge-difficulty {{dificultad_ruta}}">
                    {{dificultad_ruta}}
                </span>
            </div>

            <div class="card-sub-info">
                <p class="card-text">{{descripcion_corta}}</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="km-info">{{km}} km</span>
                    <span class="address-info">
                        <i class="bi bi-geo-alt-fill text-success"></i> {{direccion}}
                    </span>
                </div>
            </div>
        </div>

        <div class="card-footer custom-footer">
            {{#if es_favorita}}
            <form action="/rutaNoFav/{{id_ruta}}" method="POST" class="fav-form">
                <button type="submit" class="btn-fav">
                    <i class="bi bi-heart-fill text-danger"></i>
                </button>
            </form>
            {{else}}
            <form action="/rutaFav/{{id_ruta}}" method="POST" class="fav-form">
                <button type="submit" class="btn-fav">
                    <i class="bi bi-suit-heart"></i>
                </button>
            </form>
            {{/if}}

            <a href="/detalleRuta/{{id_ruta}}" class="btn-detail">
                Detalle
            </a>
        </div>
    </div>
    {{/each}}
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        {{#each routes}}
        (function() {
            const map = L.map('map-{{id_ruta}}', {
                attributionControl: false,
                doubleClickZoom: false
            });

            L.tileLayer('https://{s}.tile.openstreetmap.de/{z}/{x}/{y}.png').addTo(map);

            //convertir las coords a GeoJSON
            const geojson = {{{geom_json}}};

            const layer = L.geoJSON(geojson, {
                color: 'green',
                weight: 4
            }).addTo(map);

            const coords = geojson.coordinates;

            //punto de inicio de la ruta
            const inicio = coords[0];

            L.marker([inicio[1], inicio[0]])
            .addTo(map)
            .bindPopup("Inicio de la ruta");

            //ajustar el zoom
            map.fitBounds(layer.getBounds());

            //poder ver el mapa bien
            setTimeout(() => {
                map.invalidateSize();
            }, 100);
        })();
        {{/each}}

    });

    function filtros() {
        const dificultadSeleccionada = document.getElementById('filtroDificultad').value.toLowerCase();
        const tipoSeleccionado = document.getElementById('filtroTipoRuta').value.toLowerCase();
        
        const checkboxes = document.querySelectorAll('.filtro-direccion:checked');
        const direccionesSeleccionadas = Array.from(checkboxes).map(cb => cb.value.toLowerCase());

        const cards = document.querySelectorAll('.custom-card');

        cards.forEach(card => {
            const dificultad = card.getAttribute('data-dificultad').toLowerCase();
            const tipo = card.getAttribute('data-tipo').toLowerCase();
            const direccion = card.getAttribute('data-direccion').toLowerCase();

            const coincideDificultad = (dificultadSeleccionada === "" || dificultad === dificultadSeleccionada);
            const coincideTipo = (tipoSeleccionado === "" || tipo === tipoSeleccionado);
            
            const coincideDireccion = (direccionesSeleccionadas.length === 0 || direccionesSeleccionadas.includes(direccion));

            if (coincideDificultad && coincideTipo && coincideDireccion) {
                card.style.display = "flex";
            } else {
                card.style.display = "none";
            }
        });
    } 
</script>
<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4 text-center">Listado de mis rutas</h1>
            <div class="table-responsive">
                <table class="table table-striped table-hover mt-3">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Nombre de la Ruta</th>
                            <th scope="col">Dificultad</th>
                            <th scope="col">KM</th>
                            <th scope="col">Ubicación</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each rutasUsuario}}
                        <tr>
                            <td class="align-middle fw-bold">{{nombre_ruta}}</td>
                            <td class="align-middle">
                                <span class="badge {{#if (eq dificultad_ruta 'Fácil')}}bg-success{{else if (eq dificultad_ruta 'Normal')}}bg-warning{{else}}bg-danger{{/if}}">
                                    {{dificultad_ruta}}
                                </span>
                            </td>
                            <td class="align-middle">{{km}} km</td>
                            <td class="align-middle text-muted">{{direccion}}</td>
                            <td class="align-middle">
                                <a href="/miRuta/{{id_ruta}}" class="btn btn-outline-primary btn-sm">Detalle de la ruta</a>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">
                                No has agregado ninguna ruta por el mommento
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

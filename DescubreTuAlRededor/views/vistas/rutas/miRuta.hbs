<div class="container-fluid mt-4">

    <!-- Título -->
    <div class="row mb-4">
        <div class="col text-center">
            <h3>{{ruta.nombre_ruta}}</h3>
        </div>
    </div>

    <div class="row">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-9">

            <!-- Foto principal -->
            <div class="photo-box mb-4">
                <img src="{{ruta.mapa_ruta}}" alt="Mapa de la ruta"
                    style="width: 100%; height: 100%; object-fit: contain; display: block;">
            </div>

            <!-- Segunda foto -->
            <div class="photo-box mb-4">
                Fotos de la ruta, pero del entorno o del paiseje
            </div>

            <!-- Comentarios -->
            <div class="comment-box">
                Comentarios
            </div>

        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-3">

            <div class="side-box mb-3">
                <strong>Direction Google Maps</strong>
            </div>

            <div class="side-box mb-3">
                <strong>Nota global de la ruta por todos los usuario</strong>
            </div>

            <div class="side-box description-box">
                Descripcion con datos de cicha ruta
                <p>Descripcion {{ruta.descripcion}}</p>
                <br>
                <p>Km -> {{ruta.km}}</p>
                <p>Desnivel positivo -> {{ruta.desnivel_pos}}</p>
                <p>Desnivel negativo -> {{ruta.desnivel_neg}}</p>
                <p>Altura maxima -> {{ruta.altura_max}}</p>
                <p>Altura minima -> {{ruta.altura_min}}</p>
            </div>
        </div>
    </div>
</div>
<br>
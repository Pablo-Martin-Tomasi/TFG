<div class="anadirRuta d-flex justify-content-center align-items-center">
    <div class="anadirRutaFormulario">
        <h1>Editar ruta</h1>
        <form action="/editarRuta/{{id_ruta}}" method="POST">
            <label for="nombre_ruta">Nombre de la ruta*</label>
            <input type="text" id="nombre_ruta" name="nombre_ruta" placeholder="Nombre de la ruta"
                value="{{ruta.nombre_ruta}}" required>

            <label for="dificultad_ruta">Dificultad*</label>
            <select name="dificultad_ruta">
                <option value="Fácil" {{#if (eq ruta.dificultad_ruta "Fácil" )}}selected{{/if}}>Fácil</option>
                <option value="Normal" {{#if (eq ruta.dificultad_ruta "Normal" )}}selected{{/if}}>Normal</option>
                <option value="Difícil" {{#if (eq ruta.dificultad_ruta "Difícil" )}}selected{{/if}}>Difícil</option>
            </select>

            <label for="descripcion">Descripción*</label>
            <textarea type="text" id="descripcion" name="descripcion" placeholder="Descripción de la ruta" rows="3"
                required>{{ruta.descripcion}}</textarea>

            <label for="duracion_estimacion">Tiempo (min)*</label>
            <input type="number" id="duracion_estimacion" name="duracion_estimacion"
                placeholder="Tiempo estimado de la ruta (min)" value="{{ruta.duracion_estimacion}}" required>

            <label for="tipo_ruta">Tipo de la ruta*</label>
            <select name="tipo_ruta">
                <option value="circular" {{#if (eq ruta.tipo_ruta "circular" )}}selected{{/if}}>Circular</option>
                <option value="ida_vuelta" {{#if (eq ruta.tipo_ruta "ida_vuelta" )}}selected{{/if}}>Ida y vuelta
                </option>
            </select>


            <div class="d-flex justify-content-center gap-5 mt-4">
                <button type="submit">Modificar datos ruta</button>
                <a href="/detalleRuta/{{id_ruta}}" class="btn btn-warning btn-volver px-4" role="button">Volver</a>
            </div>
        </form>
    </div>
</div>
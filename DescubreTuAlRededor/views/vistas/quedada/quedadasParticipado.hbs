<div class="container my-5">
    <div class="d-flex justify-content-start">
        <a href="javascript:history.back()" class="btn-volver-perfil">
            <i class="bi bi-arrow-left-circle-fill"></i> Volver
        </a>
    </div>

    <div class="contenedor-quedadas">
        {{#each quedadasPar}}
        <div class="quedada-card">
            <div class="quedada-body">
                <div class="quedada-date-badge">
                    <i class="bi bi-calendar-event"></i>
                    {{formatDate dia}}
                </div>

                <h5 class="quedada-title">{{nombre_ruta}}</h5>

                <div class="quedada-info-item">
                    <i class="bi bi-geo-alt"></i>
                    <span>Dirección: <strong>{{direcion}}</strong></span>
                </div>
            </div>

            <div class="quedada-footer">
                <a href="/detalleQuedada/{{id_quedada}}" class="btn-quedada-detail">
                    Ver detalles <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
        {{else}}
        <div class="quedada-empty">
            <div class="empty-icon-container">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h3>No as particiapdo en ninguna quedada</h3>
            <p>No has participado en ninguna quedada. Busca una quedada de una ruta y participa en ella</p>
            <a href="/verQuedadas" class="btn-quedada-detail mt-4 d-inline-block">
                <i class="bi bi-search me-2"></i> Explorar las quedadas disponibles
            </a>
        </div>
        {{/each}}
    </div>
</div>
<div class="contenedor-quedadas">
    {{#each quedadas}}
    <div class="quedada-card">
        <div class="quedada-body">
            <div class="quedada-date-badge">
                <i class="bi bi-calendar-event"></i>
                {{formatDate dia}}
            </div>

            <h5 class="quedada-title">{{nombre_ruta}}</h5>

            <div class="quedada-info-item">
                <i class="bi bi-geo-alt"></i>
                <span>Dirección: <strong>{{direcion}}</strong></span>
            </div>
        </div>

        <div class="quedada-footer">
            <a href="/detalleQuedada/{{id_quedada}}" class="btn-quedada-detail">
                Ver detalles <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    {{else}}
    <div class="quedada-empty">
        <div class="empty-icon-container">
            <i class="bi bi-calendar-x"></i>
        </div>
        <h3>No hay quedadas programadas</h3>
        <p>Propon una quedada ¡ve a buscar tu ruta favorita y propón una!</p>
        <a href="/verRutas" class="btn-quedada-detail mt-4 d-inline-block">
            <i class="bi bi-search me-2"></i> Explorar Rutas
        </a>
    </div>
    {{/each}}
</div>
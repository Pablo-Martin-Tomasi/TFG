<div class="loginRegistro">
    <div class="login-container">
        <h1>Únete a nosotros</h1>
        <p>¿Ya tienes una cuenta? <a href="/login">Inicia sesión aquí</a></p>
        
        <form action="/register" method="post">
            <div class="form-group">
                <i class="bi bi-person"></i>
                <input type="text" name="nombre" placeholder="Nombre completo" required>
            </div>

            <div class="form-group">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email" placeholder="Correo electrónico" required>
            </div>
            
            <div class="form-group">
                <i class="bi bi-lock"></i>
                <input type="password" name="contrasena" placeholder="Contraseña segura" required>
            </div>

            <div class="btn-group-custom">
                <button type="submit" class="btn-login-main">Crear Cuenta</button>
                <a href="/" class="btn-login-back">Volver</a>
            </div>
        </form>

        {{#if error}}
        <div class="alert alert-danger d-flex align-items-center gap-2 justify-content-center">
            <i class="bi bi-exclamation-triangle-fill"></i>
            {{error}}
        </div>
        {{/if}}
    </div>
</div>
<div class="loginRegistro d-flex justify-content-center align-items-center">
    <div class="login-container">
        <h1>Resgistro</h1>
        <p>¿Ya eres miembro? <a href="login">Iniciar sesión</a></p>
        <form action="/register" method="post">
            <input type="text" name="nombre" placeholder="Nombre de usuario" required><br>
            <input type="email" name="email" placeholder="Correo electronico" required><br>
            <input type="password" name="contrasena" placeholder="Contraseña" required><br>
            <button type="submit">Registrarse</button>
            <a href="/" class="btn btn-warning btn-volver" role="button">Volver</a>
        </form>
        {{#if error}}
        <div class="alert alert-danger">
            {{error}}
        </div>
        {{/if}}
    </div>
</div>
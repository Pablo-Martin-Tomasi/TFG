<div class="editarPerfilContendor">
    <div class="modificarDatosUsuarioFormulario">
        <h1>🔐 Modificar contraseña</h1>
        <form action="/modificarContrasenia" method="POST">
            <input type="password" name="contraseniaActual" placeholder="Contraseña actual" required><br>
            <input type="password" name="contraseniaNueva" placeholder="Nueva contraseña" required><br>
            <input type="password" name="confirmarContrasenia" placeholder="Confirmar nueva contraseña" required><br>
            
            <button type="submit">Cambiar Contraseña</button>
            <a href="/configuracion" class="btn btn-warning btn-volver" role="button">Volver</a>
        </form>

        {{#if error}}
        <div class="alert alert-danger mt-3">
            {{error}}
        </div>
        {{/if}}
    </div>
</div>
<div class="loginRegistro">
    <div class="login-container">
        <h1>¡Hola de nuevo!</h1>
        <p>¿Aún no tienes cuenta? <a href="/register">Crea una ahora</a></p>
        
        <form action="/login" method="post">
            <div class="form-group">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email" placeholder="Correo electrónico" required>
            </div>
            
            <div class="form-group">
                <i class="bi bi-lock"></i>
                <input type="password" name="contrasena" placeholder="Contraseña" required>
            </div>

            <div class="btn-group-custom">
                <button type="submit" class="btn-login-main">Iniciar Sesión</button>
                <a href="/" class="btn-login-back">Volver</a>
            </div>
        </form>

        {{#if error}}
        <div class="alert alert-danger d-flex align-items-center gap-2 justify-content-center">
            <i class="bi bi-exclamation-triangle-fill"></i>
            {{error}}
        </div>
        {{/if}}
    </div>
</div>
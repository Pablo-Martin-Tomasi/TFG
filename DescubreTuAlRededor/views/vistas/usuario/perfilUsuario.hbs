<div class="perfilUsuario d-flex justify-content-center align-items-center">
    <div class="card shadow-lg cardPerfilUsuario p-4">

        <!-- Imagen y nombre del usuario -->
        <div class="d-flex align-items-center mb-3">
            <a href="/configuracion" class="btn btn-secondary btn-sm btn-volver-index bi bi-gear">
            </a>
            <img src="{{fotoPerfil}}" alt="Foto de perfil" class="fotoDePerfil me-3" />
            <h3 class="mb-0">{{nombre}}</h3>
        </div>

        <!-- Datos del usuario -->
        <div>
            <h5><strong>Descripción</strong></h5>
            <p>{{descripcion}}</p>
            <a href="/misRutas" class="btn btn-primary btn-sm btn-custom" role="button">Mis rutas</a>
        </div>

        <div class="section-divider"></div>

        <!-- Botones de rutas hechas y por hacer -->
        <div class="d-grid gap-2">
            <a href="/verRutasHechas" class="btn btn-success btn-custom" role="button">Ver rutas hechas</a>
            <a href="/verRutasPorHacer" class="btn btn-warning btn-custom" role="button">Ver rutas por hacer</a>
        </div>
    </div>
</div>
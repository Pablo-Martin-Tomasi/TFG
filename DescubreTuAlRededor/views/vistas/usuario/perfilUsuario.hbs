<div class="perfilUsuario d-flex justify-content-center align-items-center">
    <div class="card shadow-lg cardPerfilUsuario p-4">

        <!-- Imagen y nombre del usuario -->
        <div class="d-flex align-items-center mb-3">
            <a href="/configuracion" class="btn btn-secondary btn-sm btn-volver-index bi bi-gear">
            </a>
            <img src="{{fotoPerfil}}" alt="Foto de perfil" class="fotoDePerfil me-3" />
            <h3 class="mb-0">{{nombre}}</h3>
        </div>

        <!-- Datos del usuario -->
        <div>
            <h5><strong>Descripción</strong></h5>
            <p>{{descripcion}}</p>
        </div>

        <div class="section-divider"></div>

        <!-- Botones de rutas hechas y por hacer -->
        <div class="d-grid gap-2">
            <a href="/misRutas" class="btn text-white" style="background-color: #2d6a4f;">Mis rutas</a>
            <a href="/historialRutas" class="btn text-white" style="background-color: #40916c;">Ver rutas hechas</a>
            <a href="/rutasFav" class="btn text-dark" style="background-color: #ffbe0b;">Rutas favoritas</a>
        </div>

        <div class="section-divider"></div>

        <div class="d-grid gap-2">
            <a href="/quedadasOrganizadas" class="btn text-white" style="background-color: #6a4c93;">Quedadas
                organizadas</a>
            <a href="/quedadasApuntado" class="btn text-white" style="background-color: #e63946;">Quedadas a las que has
                participado</a>
        </div>
    </div>
</div>
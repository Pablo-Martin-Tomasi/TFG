<div class="loginRegistro d-flex justify-content-center align-items-center">
    <div class="login-container">
        <h1>Resgistro</h1>
        <p>¿Ya eres miembro? <a href="login">Iniciar sesión</a></p>
        <form>
            <input type="text" placeholder="Nombre de usuario" required><br>
            <input type="email" placeholder="Correo electronico" required><br>
            <input type="password" placeholder="Contraseña" required><br>
            <button type="submit">Registrarse</button>
            <a href="/" class="btn btn-warning btn-volver" role="button">Volver</a>
        </form>
    </div>
</div>
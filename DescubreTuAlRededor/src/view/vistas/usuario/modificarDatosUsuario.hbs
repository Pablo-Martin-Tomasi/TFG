<div class="modificarDatosUsuario d-flex justify-content-center align-items-center">
    <div class="modificarDatosUsuarioFormulario">
        <h1>Cambiar tus datos</h1>
        <form action="/modificarDatosUsuario" method="POST">
            <input type="text"  name="nombre" placeholder="Nombre de usuario" value="{{nombre}}" required><br>
            <textarea type="text" name="descripcion" rows="4" placeholder="Ingresa la descripcion"
                required>{{descripcion}}</textarea>
            <button type="submit">Confirmar</button>
            <a href="/perfilUsuario" class="btn btn-warning btn-volver" role="button">Volver</a>
        </form>
    </div>
</div>